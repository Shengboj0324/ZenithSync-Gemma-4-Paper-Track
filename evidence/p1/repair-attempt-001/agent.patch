@@ -0,0 +1,11 @@
+from requests.utils import super_len
+
+def test_super_len_str():
+    s = "hello"
+    print("len(hello): %s, super_len(hello): %s" % (len(s), super_len(s)))
+    
+    s_unicode = "hello \u2713"
+    print("len(unicode): %s, super_len(unicode): %s" % (len(s_unicode), super_len(s_unicode)))
+
+if __name__ == "__main__":
+    test_super_len_str()
