+#!/usr/bin/env python
+"""Script to reproduce the issue with yielding a list of futures in @gen.engine"""
+
+from tornado import gen
+from tornado.concurrent import return_future
+from tornado.testing import AsyncTestCase
+
+
+class GenTest(AsyncTestCase): 
+    @return_future
+    def async_future(self, result, callback): 
+        self.io_loop.add_callback(callback, result)
+
+    def test_multi_future(self): 
+        @gen.engine
+        def f(): 
+            # This should work but currently raises AssertionError
+            results = yield [self.async_future(1), self.async_future(2)]
+            print("Results:", results)
+            self.stop()
+        
+        f()
+        self.wait()
+
+
+if __name__ == "__main__":
+    import unittest
+    test = GenTest()
+    test.setUp()
+    try:
+        test.test_multi_future()
+        print("SUCCESS: Test passed!")
+    except Exception as e:
+        print(f"ERROR: {type(e).__name__}: {e}")
+        import traceback
+        traceback.print_exc()
